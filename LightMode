                  - script
        night_boolean_scenes_scripts:
          name: Luzes Noturnas - Cenas e Scripts - Auxiliar de Alternância
          description: >
            Para garantir o bom funcionamento da automação, recomenda-se criar um auxiliar de alternância independente ao selecionar uma cena ou um script em "Luzes Noturnas" acima e introduzi-lo aqui.
          default: []
          selector:
            entity:
              filter:
                domain:
                  - input_boolean
        night_time_delay:
          name: Luzes Noturnas - Atraso de Tempo
          description: >
            O atraso de tempo determina durante quanto tempo as luzes noturnas permanecem ativas depois de todos os acionadores ficarem inativos, iniciando o atraso para as DESLIGAR.
          default: 5
          selector:
            number:
              min: 0
              max: 30
              step: 0.5
              unit_of_measurement: minutos

    night_lights_light_control_settings:
      name: "Controlo das Luzes Noturnas"
      icon: mdi:lightbulb-on-80
      collapsed: true
      input:
        include_night_light_control:
          name: Luzes Noturnas - Opções de Controlo das Luzes (Opcional)
          description: >
            Selecione se pretende utilizar luminosidade ou transição. Estas definições só afetam uma entidade 'light' que suporte cada uma das opções selecionadas.
            As definições de luminosidade e de transição encontram-se abaixo.

            Selecionar a opção 'Se as luzes estiverem LIGADAS, ajustar as luzes na passagem' garante que as definições de controlo das luzes são aplicadas às luzes que já estejam LIGADAS durante a transição das luzes normais para as luzes noturnas e vice-versa.

            Selecionar 'Sim - Gerir o script de DESLIGAR na passagem' é benéfico para scripts que contêm ações if-then-else que ativam e desativam várias funções durante a transição das luzes normais para as luzes noturnas e vice-versa.
          default: []
          selector:
            select:
              multiple: true
              options:
                - label: Utilizar luminosidade
                  value: "use_brightness"
                - label: Utilizar transição
                  value: "use_transition"
                - label: Se as luzes estiverem LIGADAS, ajustar as luzes na passagem
                  value: "if_lights_are_on_adjust_when_crossing_over"
                - label: Sim - Gerir o script de DESLIGAR na passagem
                  value: "manage_scripts_crossing_over"
        night_light_brightness:
          name: Luzes Noturnas - Luminosidade
          description: >
            A definição de luminosidade das luzes quando são LIGADAS.
          default: 20
          selector:
            number:
              min: 1
              max: 100
              mode: slider
              step: 1
              unit_of_measurement: '%'
        night_light_transition_on:
          name: Luzes Noturnas - Transição - LIGAR
          description: >
            A transição das luzes quando são LIGADAS.
          default: 1
          selector:
            number:
              min: 0
              max: 5
              mode: slider
              step: 0.5
              unit_of_measurement: segundos
        night_light_transition_off:
          name: Luzes Noturnas - Transição - DESLIGAR
          description: >
            A transição das luzes quando são DESLIGADAS.
          default: 1
          selector:
            number:
              min: 0
              max: 30
              mode: slider
              step: 1
              unit_of_measurement: segundos
        include_night_light_colour_control:
          name: Luzes Noturnas - Opções de Controlo de Cor das Luzes (Opcional)
          description: >
            Selecione se pretende utilizar temperatura de cor, cor RGB, RGBW ou RGBWW. Estas definições só afetam uma entidade 'light' que suporte cada uma das opções selecionadas.
            As definições de temperatura de cor e de cor RGB, RGBW e RGBWW encontram-se abaixo
          default: disable_colour_control
          selector:
            select:
              options:
                - label: Utilizar Temperatura de Cor
                  value: "use_colour_temperature"
                - label: Utilizar Cor RGB
                  value: "use_rgb_colour"
                - label: Utilizar Cor RGBW
                  value: "use_rgbw_colour"
                - label: Utilizar Cor RGBWW
                  value: "use_rgbww_colour"
                - label: Desativar o Controlo de Cor
                  value: "disable_colour_control"
        night_light_colour_temperature:
          name: Luzes Noturnas - Temperatura de Cor
          description: >
            A definição de temperatura de cor das luzes quando são LIGADAS.
          default: 5000
          selector:
            number:
              min: 2000
              max: 8000
              mode: slider
              step: 100
              unit_of_measurement: 'kelvin'
        night_light_rgb_colour:
          name: Luzes Noturnas - Cor RGB
          description: >
            A definição de cor RGB das luzes quando são LIGADAS.
          default: [255, 255, 255]
          selector:
            color_rgb:
        night_light_rgbw_colour:
          name: Luzes Noturnas - Cor RGBW
          description: >
            A definição de cor RGBW das luzes quando são LIGADAS. Introduza quatro números inteiros entre 0 e 255 para definir os valores de Vermelho, Verde, Azul e Branco.
          default: [255, 255, 255, 255]
          selector:
            object:
        night_light_rgbww_colour:
          name: Luzes Noturnas - Cor RGBWW
          description: >
            A definição de cor RGBWW das luzes quando são LIGADAS. Introduza cinco números inteiros entre 0 e 255 para definir os valores de Vermelho, Verde, Azul, Branco Frio e Branco Quente.
          default: [255, 255, 255, 255, 255]
          selector:
            object:
        night_light_include_dim_before_off:
          name: Utilizar a Opção Reduzir Luminosidade Antes de Desligar (Opcional)
          description: >
            Esta opção reduz a luminosidade das luzes noturnas como aviso visual antes de serem DESLIGADAS. Dá-lhe tempo para acionar o sensor de movimento caso queira que as luzes noturnas permaneçam LIGADAS.

            ***Nota** - Esta opção não funciona quando o **Brilho Noturno** está ativado, mesmo que esteja ativada aqui.*
          default: dim_before_off_disabled
          selector:
            select:
              options:
                - label: Ativar a opção Reduzir Luminosidade Antes de Desligar
                  value: "dim_before_off_enabled"
                - label: Desativar a opção Reduzir Luminosidade Antes de Desligar
                  value: "dim_before_off_disabled"
        night_light_dim_before_off_pct:
          name: Reduzir Luminosidade Antes de Desligar - Percentagem
          description: >
            Defina quanto reduzir a luminosidade das suas luzes noturnas durante o aviso de redução. Por exemplo, 50 significa que a luminosidade será reduzida em 50%.
          default: 50
          selector:
            number:
              min: 1
              max: 100
              mode: slider
              step: 1
              unit_of_measurement: '%'
        night_light_dim_before_off_time_delay:
          name: Reduzir Luminosidade Antes de Desligar - Atraso de Tempo
          description: >
            Defina durante quanto tempo manter as luzes noturnas no nível de luminosidade reduzido antes de as DESLIGAR.
          default: 30
          selector:
            number:
              min: 0
              max: 60
              mode: slider
              step: 1
              unit_of_measurement: segundos
        night_light_dim_before_off_boolean:
          name: Reduzir Luminosidade Antes de Desligar - Auxiliar de Alternância
          description: >
            Este auxiliar de alternância regista se as luzes noturnas foram reduzidas. Selecione um auxiliar de alternância para registar o estado de luminosidade reduzida das luzes noturnas.
            Quando está LIGADO, a automação sabe que as luzes noturnas se encontram atualmente no estado reduzido e restaura a luminosidade anterior se a automação for acionada novamente antes de as luzes noturnas se DESLIGAREM.

            Este auxiliar tem de ser utilizado exclusivamente por este campo da automação e não pode ser utilizado no **auxiliar de alternância de Reduzir Luminosidade Antes de Desligar das Luzes Normais**.
          default: []
          selector:
            entity:
              filter:
                domain:
                  - input_boolean

