blueprint:
  name: Luzes e interruptores ligados há demasiado tempo
  author: Tiago
  description: >-
    Verifica de minuto a minuto as luzes (incluindo LEDs) e os interruptores
    que estão ligados há mais de X minutos, avisa-te e, opcionalmente, desliga-os
    automaticamente e confirma se o desligar funcionou.


    **Seleção de entidades**: todas, só as que escolheres, ou todas exceto as que
    escolheres. Podes ainda excluir por padrão (regex) no entity_id.


    **Notificações**: escolhe os destinatários (entidades notify). Os avisos do
    mesmo tipo no mesmo minuto são agrupados numa só mensagem com os nomes das
    entidades. As mensagens são personalizáveis.


    Nota: o tempo conta a partir da última mudança de estado. Após um reinício
    do HA os contadores recomeçam.
  domain: automation
  homeassistant:
    min_version: "2024.10.0"
  input:
    scope_section:
      name: Entidades a monitorizar
      icon: mdi:lightbulb-group
      collapsed: false
      input:
        domains:
          name: Domínios
          description: Tipos de entidade a monitorizar.
          default:
            - light
            - switch
          selector:
            select:
              multiple: true
              options:
                - label: Luzes e LEDs (light)
                  value: light
                - label: Interruptores e tomadas (switch)
                  value: switch
        selection_mode:
          name: Modo de seleção
          description: >-
            Todas as entidades dos domínios acima, só as escolhidas, ou todas
            exceto as escolhidas.
          default: all
          selector:
            select:
              mode: list
              options:
                - label: Todas
                  value: all
                - label: Apenas as que eu escolher
                  value: include
                - label: Todas, exceto as que eu escolher
                  value: exclude
        include_entities:
          name: Entidades a incluir
          description: Usado quando o modo é "Apenas as que eu escolher".
          default: []
          selector:
            entity:
              multiple: true
              filter:
                - domain:
                    - light
                    - switch
        exclude_entities:
          name: Entidades a excluir
          description: Usado quando o modo é "Todas, exceto as que eu escolher".
          default: []
          selector:
            entity:
              multiple: true
              filter:
                - domain:
                    - light
                    - switch
        exclude_pattern:
          name: Excluir por padrão (regex, opcional)
          description: >-
            Aplicado ao entity_id em qualquer modo, sem distinguir maiúsculas.
            Exemplo: detect|recordings|snapshots|indicator
          default: ""
          selector:
            text: {}
    timing_section:
      name: Tempos e desligar automático
      icon: mdi:timer-outline
      collapsed: false
      input:
        max_on_minutes:
          name: Tempo máximo ligado (minutos)
          description: Passado este tempo é enviado o alerta.
          default: 60
          selector:
            number:
              min: 1
              max: 1440
              step: 1
              unit_of_measurement: min
              mode: box
        auto_off_enabled:
          name: Desligar automaticamente
          default: false
          selector:
            boolean: {}
        auto_off_delay:
          name: Desligar passados X minutos após o tempo máximo
          description: >-
            0 = desliga logo ao atingir o tempo máximo (uma única notificação
            com o resultado). Acima de 0 envia primeiro o alerta e desliga
            depois.
          default: 0
          selector:
            number:
              min: 0
              max: 1440
              step: 1
              unit_of_measurement: min
              mode: box
    notify_section:
      name: Notificações
      icon: mdi:bell-ring
      collapsed: false
      input:
        destinatarios:
          name: Destinatários
          description: >-
            Uma ou mais entidades de notificação (por exemplo os telemóveis).
            Cada destinatário recebe uma notificação.
          default: []
          selector:
            entity:
              domain:
                - notify
              multiple: true
        persistent_notification:
          name: Criar também notificação persistente no HA
          default: false
          selector:
            boolean: {}
        acoes_extra:
          name: Ações adicionais (opcional)
          description: >-
            Executadas depois da notificação (TTS, outro serviço...). Podes usar
            {{ titulo }}, {{ mensagem }}, {{ nomes }} (lista de nomes),
            {{ entity_ids }} (lista) e {{ tipo }} (alerta, desligado ou falha).
          default: []
          selector:
            action: {}
    messages_section:
      name: Mensagens
      icon: mdi:message-text
      collapsed: true
      input:
        titulo_alerta:
          name: Título - alerta
          default: "⚠️ Ligado há demasiado tempo"
          selector:
            text: {}
        mensagem_alerta:
          name: Mensagem - alerta
          description: >-
            Variáveis: nomes (lista), qtd, tempo (tempo máximo), atraso (tempo
            até desligar) e desliga_auto (true/false).
          default: "{{ nomes | join(', ') }} {{ 'está ligado' if qtd == 1 else 'estão ligados' }} há mais de {{ tempo }}.{{ (' Será desligado automaticamente dentro de ' ~ atraso ~ '.') if desliga_auto else '' }}"
          selector:
            text:
              multiline: true
        titulo_desligado:
          name: Título - desligado com sucesso
          default: "✅ Desligado automaticamente"
          selector:
            text: {}
        mensagem_desligado:
          name: Mensagem - desligado com sucesso
          description: >-
            Variáveis: nomes (lista), qtd e tempo_total (tempo que estiveram
            ligados até serem desligados).
          default: "{{ nomes | join(', ') }} {{ 'estava ligado' if qtd == 1 else 'estavam ligados' }} há mais de {{ tempo_total }} e {{ 'foi desligado' if qtd == 1 else 'foram desligados' }} com sucesso."
          selector:
            text:
              multiline: true
        titulo_falha:
          name: Título - falha ao desligar
          default: "⚠️ Falha ao desligar"
          selector:
            text: {}
        mensagem_falha:
          name: Mensagem - falha ao desligar
          description: "Variáveis: as mesmas da mensagem de desligado."
          default: "Não foi possível desligar {{ nomes | join(', ') }} (ligado há mais de {{ tempo_total }})."
          selector:
            text:
              multiline: true

mode: single
max_exceeded: silent

triggers:
  - trigger: time_pattern
    minutes: "/1"

variables:
  domains: !input domains
  selection_mode: !input selection_mode
  include_entities: !input include_entities
  exclude_entities: !input exclude_entities
  exclude_pattern: !input exclude_pattern
  max_on_minutes: !input max_on_minutes
  auto_off: !input auto_off_enabled
  off_delay: !input auto_off_delay
  destinatarios: !input destinatarios
  use_persistent: !input persistent_notification
  alert_secs: "{{ (max_on_minutes | int(60)) * 60 }}"
  off_secs: "{{ alert_secs + (off_delay | int(0)) * 60 }}"
  labels: >-
    {%- macro fmt(m) -%}
      {%- set h = m // 60 -%}
      {%- set r = m % 60 -%}
      {{- (h ~ ' h') if h > 0 else '' -}}
      {{- ' ' if (h > 0 and r > 0) else '' -}}
      {{- (r ~ ' min') if (r > 0 or h == 0) else '' -}}
    {%- endmacro -%}
    {{ {'alert': fmt(max_on_minutes | int(60)), 'off': fmt((max_on_minutes | int(60)) + (off_delay | int(0))), 'delay': fmt(off_delay | int(0))} }}
  tempo: "{{ labels.alert }}"
  atraso: "{{ labels.delay }}"
  tempo_total: "{{ labels.off }}"
  desliga_auto: "{{ auto_off }}"
  monitored: >-
    {%- set ns = namespace(items=[]) -%}
    {%- for s in states if s.domain in domains and s.state == 'on' -%}
      {%- set picked = (selection_mode == 'all')
          or (selection_mode == 'include' and s.entity_id in include_entities)
          or (selection_mode == 'exclude' and s.entity_id not in exclude_entities) -%}
      {%- set blocked = (exclude_pattern | string | length > 0)
          and (s.entity_id | regex_search(exclude_pattern | string, ignorecase=true)) -%}
      {%- if picked and not blocked -%}
        {%- set ns.items = ns.items + [{'entity_id': s.entity_id, 'name': s.name, 'age': (now() - s.last_changed).total_seconds()}] -%}
      {%- endif -%}
    {%- endfor -%}
    {{ ns.items }}
  to_alert: >-
    {{ [] if (auto_off and (off_delay | int(0)) == 0)
       else monitored | selectattr('age', 'ge', alert_secs) | selectattr('age', 'lt', alert_secs + 60) | list }}
  to_off: >-
    {{ [] if not auto_off
       else monitored | selectattr('age', 'ge', off_secs) | list }}

conditions:
  - condition: template
    value_template: "{{ (to_alert | length > 0) or (to_off | length > 0) }}"

actions:
  - alias: Desligar automaticamente e aguardar confirmação
    if:
      - condition: template
        value_template: "{{ to_off | length > 0 }}"
    then:
      - action: homeassistant.turn_off
        target:
          entity_id: "{{ to_off | map(attribute='entity_id') | list }}"
      - wait_template: >-
          {%- set ns = namespace(pending=0) -%}
          {%- for e in to_off -%}
            {%- if not is_state(e.entity_id, 'off') -%}
              {%- set ns.pending = ns.pending + 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {{ ns.pending == 0 }}
        timeout: 15
        continue_on_timeout: true

  - alias: Agrupar entidades por tipo de aviso
    variables:
      eventos: >-
        {%- set ns = namespace(items=[], ok_n=[], ok_i=[], fa_n=[], fa_i=[]) -%}
        {%- for e in to_off -%}
          {%- if is_state(e.entity_id, 'off') -%}
            {%- set ns.ok_n = ns.ok_n + [e.name] -%}
            {%- set ns.ok_i = ns.ok_i + [e.entity_id] -%}
          {%- elif e.age < off_secs + 120 -%}
            {%- set ns.fa_n = ns.fa_n + [e.name] -%}
            {%- set ns.fa_i = ns.fa_i + [e.entity_id] -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if to_alert | length > 0 -%}
          {%- set ns.items = ns.items + [{'tipo': 'alerta', 'nomes': to_alert | map(attribute='name') | unique | list, 'entity_ids': to_alert | map(attribute='entity_id') | list}] -%}
        {%- endif -%}
        {%- if ns.ok_n | length > 0 -%}
          {%- set ns.items = ns.items + [{'tipo': 'desligado', 'nomes': ns.ok_n | unique | list, 'entity_ids': ns.ok_i}] -%}
        {%- endif -%}
        {%- if ns.fa_n | length > 0 -%}
          {%- set ns.items = ns.items + [{'tipo': 'falha', 'nomes': ns.fa_n | unique | list, 'entity_ids': ns.fa_i}] -%}
        {%- endif -%}
        {{ ns.items }}

  - alias: Enviar uma notificação por tipo de aviso
    repeat:
      for_each: "{{ eventos }}"
      sequence:
        - variables:
            tipo: "{{ repeat.item.tipo }}"
            nomes: "{{ repeat.item.nomes }}"
            entity_ids: "{{ repeat.item.entity_ids }}"
            qtd: "{{ repeat.item.nomes | length }}"
        - variables:
            titulos:
              alerta: !input titulo_alerta
              desligado: !input titulo_desligado
              falha: !input titulo_falha
            mensagens:
              alerta: !input mensagem_alerta
              desligado: !input mensagem_desligado
              falha: !input mensagem_falha
        - variables:
            titulo: "{{ titulos[tipo] }}"
            mensagem: "{{ mensagens[tipo] }}"
        - if:
            - condition: template
              value_template: "{{ destinatarios | length > 0 }}"
          then:
            - action: notify.send_message
              target:
                entity_id: !input destinatarios
              data:
                title: "{{ titulo }}"
                message: "{{ mensagem }}"
        - if:
            - condition: template
              value_template: "{{ use_persistent }}"
          then:
            - action: persistent_notification.create
              data:
                title: "{{ titulo }}"
                message: "{{ mensagem }}"
                notification_id: "{{ 'luzes_ligadas_' ~ tipo }}"
        - choose: []
          default: !input acoes_extra
